{
  "detection": {
    "frame_skip": 5,
    "confidence_threshold": 0.5,
    "iou_threshold": 0.4,
    "yolo_model": "yolov8n-face.pt",
    "input_width": 640,
    "input_height": 360
  },
  "recognition": {
    "model_name": "buffalo_l",
    "embedding_threshold": 0.60,
    "duplicate_guard_threshold": 0.75,
    "min_face_size": 40,
    "min_face_area": 1600,
    "embedding_avg_frames": 5,
    "min_track_frames_for_recognition": 5,
    "quality_laplacian_threshold": 80.0
  },
  "tracking": {
    "max_disappeared": 40,
    "max_distance": 80,
    "tracker_type": "bytetrack"
  },
  "reid": {
    "ghost_ttl_seconds": 8,
    "ghost_max_bbox_dist": 200,
    "ghost_sim_threshold": 0.55
  },
  "database": {
    "uri": "mongodb://localhost:27017",
    "name": "face_tracker_db",
    "collections": {
      "faces": "faces",
      "events": "events",
      "visitors": "visitors"
    },
    "async_write": true,
    "async_queue_size": 500
  },
  "logging": {
    "log_file": "logs/events.log",
    "image_base_dir": "logs",
    "log_level": "INFO",
    "fps_log_interval": 100
  },
  "camera": {
    "source": "sample_video.mp4",
    "rtsp_url": "rtsp://username:password@ip:port/stream",
    "use_rtsp": false,
    "display_window": true,
    "window_name": "Face Tracker"
  },
  "performance": {
    "use_gpu": true,
    "num_threads": 4,
    "batch_size": 1
  }
}